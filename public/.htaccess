# Nam Nilam Hostinger Apache Configuration
# Enables React Router SPA navigation and direct API execution

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect HTTP to HTTPS for namnilam.com
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} ^(www\.)?namnilam\.com$ [NC]
  RewriteRule ^(.*)$ https://namnilam.com/$1 [L,R=301]

  # Allow direct access to api folder
  RewriteCond %{REQUEST_URI} ^/api/
  RewriteRule ^ - [L]

  # Allow direct access to existing real files (images, css, js, icons, fonts)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Rewrite /projects/*.jpg to /public/projects/*.jpg if needed
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^projects/(.+\.(jpg|jpeg|png|webp|svg|ico))$ public/projects/$1 [L,NC]

  # Route all other frontend routes (including /projects, /services, etc.) to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Security & Caching Headers
<IfModule mod_headers.c>
  # Prevent MIME type sniffing
  Header set X-Content-Type-Options "nosniff"
  # Prevent Clickjacking
  Header set X-Frame-Options "SAMEORIGIN"
  # Enable XSS protection
  Header set X-XSS-Protection "1; mode=block"
</IfModule>
