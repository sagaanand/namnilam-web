# Nam Nilam Production Environment Configuration
# Copy this file to .env on your Hostinger server and configure secure values.
# IMPORTANT: Never commit the active .env file to git or public version control.

# Database Configuration (Hostinger MySQL)
DB_HOST=localhost
DB_NAME=u665690797_nncpro
DB_USER=u665690797_nncpro
DB_PASS=REPLACE_WITH_ROTATED_DB_PASSWORD

# Security & Authentication
# Generate a 64-character random string for JWT_SECRET
JWT_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_RANDOM_SECRET

# Bcrypt hash of authorized administrator passcode/PIN
# Generated using PHP password_hash('YOUR_PASSCODE', PASSWORD_BCRYPT)
ADMIN_PASSCODE_HASH=REPLACE_WITH_BCRYPT_HASH_OF_ADMIN_PIN
