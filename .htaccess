# Nam Nilam Hostinger Apache Configuration
# Enables React Router SPA navigation and direct API execution

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect HTTP to HTTPS for namnilam.com
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} ^(www\.)?namnilam\.com$ [NC]
  RewriteRule ^(.*)$ https://namnilam.com/$1 [L,R=301]

  # Block access to hidden, environment, and database files
  <FilesMatch "^\.env|(\.(sql|sqlite|log|ini|env|bak|sh))$">
    <IfModule mod_authz_core.c>
      Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
      Order allow,deny
      Deny from all
    </IfModule>
  </FilesMatch>

  # Pass Authorization header to PHP in FastCGI / Apache environments
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Allow direct access to api folder
  RewriteCond %{REQUEST_URI} ^/api/
  RewriteRule ^ - [L]

  # Allow direct access to existing real files (images, css, js, icons, fonts)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # If requested static file exists in public/ (e.g., logo, images), serve from public/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
  RewriteRule ^(.*)$ public/$1 [L]

  # Route all other frontend routes (including /projects, /services, etc.) to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Security & Caching Headers
<IfModule mod_headers.c>
  # Prevent MIME type sniffing
  Header set X-Content-Type-Options "nosniff"
  # Prevent Clickjacking
  Header set X-Frame-Options "SAMEORIGIN"
  # Enable XSS protection
  Header set X-XSS-Protection "1; mode=block"
</IfModule>
